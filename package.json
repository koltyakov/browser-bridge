{
  "name": "@browserbridge/bbx",
  "version": "2.1.1",
  "private": false,
  "keywords": [
    "agent-tools",
    "ai-agent",
    "browser",
    "browser-automation",
    "browser-bridge",
    "chrome",
    "chrome-extension",
    "developer-tools",
    "mcp",
    "model-context-protocol",
    "native-messaging",
    "ui-debugging"
  ],
  "homepage": "https://github.com/koltyakov/browser-bridge#readme",
  "bugs": {
    "url": "https://github.com/koltyakov/browser-bridge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koltyakov/browser-bridge.git"
  },
  "bin": {
    "bbx": "packages/npm/bin/bbx.js",
    "bbx-daemon": "packages/npm/bin/bbx-daemon.js",
    "bbx-install": "packages/npm/bin/bbx-install.js",
    "bbx-mcp": "packages/npm/bin/bbx-mcp.js"
  },
  "files": [
    "LICENSE",
    "PRIVACY.md",
    "RESPONSIBLE_USE.md",
    "README.md",
    "SECURITY.md",
    "packages/npm/bin",
    "packages/npm/src",
    "!**/test/**",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:extension": "node scripts/package-extension.mjs --build-only",
    "package:extension": "node scripts/package-extension.mjs",
    "postinstall": "node packages/npm/bin/postinstall.js"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "har-schema": "^2.0.0",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "c8": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.6"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
