{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Browser Bridge (BBX)",
  "version": "2.0.0",
  "description": "Local bridge for structured DOM, style, input, console, network, accessibility, dialog, and reversible patch workflows.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Bridge",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  }
}
